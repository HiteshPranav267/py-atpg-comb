# Copy this file to .env and fill in what you need. Everything is optional.
# .env is git-ignored. Full reference: docs/configuration.md

# --- ATALANTA -----------------------------------------------------------
# Only needed when ATALANTA is not built at Atalanta/atalanta
# (on Windows: a wrapper that runs the WSL build, see docs/configuration.md).
# ATALANTA_BIN=/path/to/atalanta

# --- Language model (optional) ------------------------------------------
# Without a key, the structural score and the detectors choose the faults.
# Set one vendor key; the vendor is taken from the variable name.
# GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=AIza...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# NVIDIA_API_KEY=nvapi-...

# Backup keys for the same vendor, used when the first is rate-limited:
# GROQ_API_KEY_2=gsk_...

# Or a generic key with an explicit provider and model:
# LLM_API_KEY=...
# LLM_PROVIDER=groq            # groq | gemini | openai | anthropic | nvidia | openai_compatible
# LLM_MODEL=openai/gpt-oss-120b

# A local model through Ollama (no key needed by Ollama, any value works):
# LLM_PROVIDER=openai_compatible
# OPENAI_COMPATIBLE_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# --- Server (only for a shared deployment) ------------------------------
# PYATPG_ADMIN_TOKEN=choose-a-long-random-string
# DATABASE_URL=postgresql://user:password@host/dbname
