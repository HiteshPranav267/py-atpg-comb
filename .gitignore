# The team's local archive: capstone paper, slides, reviews, literature,
# prototypes, bug-report notes and superseded research material.
archive/

# Experiment *results* are generated; the trojan instances under
# experiments/*/variants/ are the fixed experimental population and stay tracked.
experiments/*/results/

# Circuits dropped in for scripts/run_suite.py to pick up (see docs/automation.md) --
# transient inputs, not part of the tracked benchmark corpus.
benchmarks/incoming/*
!benchmarks/incoming/.gitkeep

# Atalanta is not part of this repository (teaching and research licence):
# build.sh fetches it at a pinned commit and applies patches/atalanta.patch.
Atalanta/

scripts/
tests/

# Scan artifact from an external indexing tool: regenerated on demand and
# full of this machine's absolute paths, so it is noise in every diff.
.orphic/
.yowasp-cache/
benchmarks/

